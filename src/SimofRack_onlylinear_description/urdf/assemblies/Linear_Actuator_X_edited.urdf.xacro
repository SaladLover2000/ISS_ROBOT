<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Linear_Actuator_X_edited_macro">

  <xacro:macro name="Linear_Actuator_X_edited" params="prefix">

    <!-- Links -->
    <link name="${prefix}Linear_Actuator_X_edited_Component18">
      <inertial>
        <origin xyz="0.026445 0.354406 0.039226" rpy="0 0 0"/>
        <mass value="8.791194"/>
        <inertia ixx="1.133893e+00" ixy="-8.257586e-06" ixz="2.680391e-07"
                 iyy="6.857405e-03" iyz="8.425553e-03" izz="1.137360e+00"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://SimofRack_onlylinear_description/meshes/Linear_Actuator_X_edited/Linear_Actuator_X_edited_Component18.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://SimofRack_onlylinear_description/meshes/Linear_Actuator_X_edited/Linear_Actuator_X_edited_Component18_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Linear_Actuator_X_edited_Component1">
      <inertial>
        <origin xyz="0.000151 -0.009943 0.008213" rpy="0 0 0"/>
        <mass value="0.346128"/>
        <inertia ixx="1.912792e-04" ixy="3.004128e-09" ixz="-8.237744e-08"
                 iyy="1.599690e-04" iyz="-6.618975e-08" izz="3.212775e-04"/>
      </inertial>
      <visual>
        <origin xyz="-0.026448 -0.301554 -0.050742" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://SimofRack_onlylinear_description/meshes/Linear_Actuator_X_edited/Linear_Actuator_X_edited_Component1.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.026448 -0.301554 -0.050742" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://SimofRack_onlylinear_description/meshes/Linear_Actuator_X_edited/Linear_Actuator_X_edited_Component1_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}Slider_2" type="prismatic">
      <parent link="${prefix}Linear_Actuator_X_edited_Component18"/>
      <child link="${prefix}Linear_Actuator_X_edited_Component1"/>
      <origin xyz="0.026448 0.610209 0.050742" rpy="0.000000 0.000000 0.000000"/>
      <axis xyz="0.000000 1.000000 0.000000"/>
      <limit lower="-0.630000" upper="0.310000" effort="100.0" velocity="1.00"/>
    </joint>

    <!-- ROS 2 control: generated generic system -->
    <ros2_control name="${prefix}Linear_Actuator_X_edited_system" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="cmd_topic">sim/Linear_Actuator_X_edited_system/cmd</param>
        <param name="state_topic">sim/Linear_Actuator_X_edited_system/state</param>
      </hardware>

      <joint name="${prefix}Slider_2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>